# CsPbBr3 slab: eigenvalues of all frames with the fitted model (params.dat of hconf_fit_wolf).
# method, rcut, alpha and qeff are taken from the header of params.dat (check_params).
begin Options
    rcut = 5.5
    verbosity = 1
    sp_mode = true
    interpolate_rllm = true
    init_params = params.dat
end

begin Supercell
    xdatcar = structures.h5
    poscar = POSCAR
    Nconf = 320
    Nconf_min = 1
    Nconf_max = 320
end

begin Ewald
    init_params = params.dat
    slab_axis = 3
end

begin atom Cs
  alpha = 38.6
  orbitals = s
  qeff = 1.02
end

begin atom Pb
  alpha = 37
  orbitals = s px py pz
  qeff = 1.248
end

begin atom Br
  alpha = 14.3
  orbitals = px py pz
  qeff = -0.756
end
