# Example config file of a fit to MD data (GaAs), used to test reading config files: comments, values with and
# without spaces around "=", upper-case keys, vectors, and atom blocks. All tags are valid (the test checks that
# reading this file gives no warnings).
#
# Inputs: POSCAR (primitive cell), SC_POSCAR and SC_XDATCAR (supercell and MD trajectory), EIGENVAL_DOS (training data).

begin Options
    skip_diag = true                        # no eigenvalues after the fit
    onsite = true                           # (default) separate parameters for the on-site elements
    interpolate_rllm = true                 # interpolate the distance dependence with cubic splines
    POSCAR = POSCAR                         # (default) primitive cell
    kpoints = EIGENVAL_bands                # k-points for a band structure
    rcut = 6                                # cut-off radius of the interactions
    sp_mode=true
    sp_tol = 1e-5
    load_rllm = true
    init_params = params.dat                # TB parameters from a file
end

# Supercell and trajectory
begin Supercell
    POSCAR = SC_POSCAR                      # supercell (default)
    XDATCAR = SC_XDATCAR                    # MD trajectory
    Nconf = 10                              # number of configurations
end

# An Optimizer block switches to a fit
begin Optimizer
    loss = MAE                              # mean absolute error
    niter = 50                              # number of iterations
    lr = 0.001                              # learning rate (Adam)
    train_data = EIGENVAL_DOS               # training data
    train_mode = md                         # supercell data
    val_mode = md
    wE_1-4 = 0.5                            # lower weight for the lowest bands
end

# Machine-learned corrections
begin ML
    npoints = 100                           # kernel data points
    ncluster = 10
    sim_params = 0.1
end

#
# Atom-specific settings, one block per species (the order of the blocks has no influence)
#
begin atom Ga
    n = 3                                  # principal quantum number of the radial functions
    alpha = 9                              # effective charge of the radial functions
    orbitals = sp3dr2 sp3dr2 sp3dr2 sp3dr2 # sp3dr2 basis set
end

begin atom As
    n = 3
    alpha = 13
    orbitals = sp3dr2 sp3dr2 sp3dr2 sp3dr2
    NNaxes = true                          # orbital axes along the bonds to the nearest neighbours
end
